# Supabase (create a project in a UK or EU region: London is eu-west-2)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used just for public form intake and the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (server only)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Bible text. Without a YouVersion key the app uses the public-domain World English Bible.
# YOUVERSION_APP_KEY=
# YOUVERSION_BIBLE_ID=
# YOUVERSION_VERSION_LABEL=
# YOUVERSION_API_BASE=https://api.youversion.com/v1

# Public URL, used for the QR code
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo: one-tap logins on /login. Turn off before real requests.
DEMO_MODE=true
DEMO_PASSWORD=change-me-demo-password
NEXT_PUBLIC_DEMO_CHURCH_SLUG=icc-luton
